flowchart TB
    subgraph Users["Users"]
        Student["Student\n(self-upload)"]
        Recruiter["Recruiter / Office Staff\n(post jobs, bulk upload)"]
    end

    subgraph Auth["Identity"]
        Cognito["Amazon Cognito\nUser Pool + Hosted UI\ngroups: students / recruiters"]
    end

    subgraph FrontendHosting["Frontend Hosting (HTTPS, no CloudFront)"]
        FrontAPI["API Gateway HTTP API\n(frontend)"]
        ServeFn["Lambda: serveFrontend"]
        FrontBucket[("S3 Bucket\nfrontend (private)\nindex/student/office/results.html")]
    end

    subgraph CoreAPI["Application API"]
        API["API Gateway HTTP API\nJWT Authorizer (Cognito)"]
        UploadFn["Lambda: createUploadUrl"]
        QueryFn["Lambda: queryApi"]
        CreateJobFn["Lambda: createJob\n(recruiters only)"]
        RankFn["Lambda: getRankedResults\n(recruiters only)"]
    end

    subgraph Pipeline["Async Resume Analysis Pipeline"]
        ResumeBucket[("S3 Bucket\nresumes")]
        IngestFn["Lambda: ingestUpload"]
        SFN["Step Functions\nResumeAnalysisStateMachine"]
        ExtractFn["Lambda: extractText"]
        Textract["Amazon Textract"]
        ParseFn["Lambda: parseScore"]
        HF["Hugging Face\nInference API"]
        NotifyFn["Lambda: notifyResult"]
        SNS["Amazon SNS"]
    end

    subgraph Scheduled["Scheduled Job Refresh"]
        EventBridge["EventBridge\nrate(24h)"]
        RefreshFn["Lambda: refreshJobs"]
    end

    subgraph Data["Data Stores"]
        JobsTable[("DynamoDB\nJobsTable")]
        ResultsTable[("DynamoDB\nResultsTable\nGSI: jobId-matchScore")]
        Secrets["Secrets Manager\nHF API token"]
    end

    Student -->|"HTTPS login"| Cognito
    Recruiter -->|"HTTPS login"| Cognito
    Student --> FrontAPI
    Recruiter --> FrontAPI
    FrontAPI --> ServeFn --> FrontBucket

    Student -->|"Bearer JWT"| API
    Recruiter -->|"Bearer JWT"| API

    API --> UploadFn
    API --> QueryFn
    API --> CreateJobFn
    API --> RankFn

    UploadFn -->|"presigned PUT URL"| ResumeBucket
    ResumeBucket -->|"ObjectCreated event"| IngestFn
    IngestFn -->|"StartExecution"| SFN
    SFN --> ExtractFn --> Textract
    SFN --> ParseFn
    ParseFn --> HF
    ParseFn --> JobsTable
    ParseFn --> ResultsTable
    ParseFn -.->|"reads token"| Secrets
    SFN --> NotifyFn --> SNS

    QueryFn --> JobsTable
    QueryFn --> ResultsTable
    CreateJobFn --> JobsTable
    RankFn --> ResultsTable

    EventBridge --> RefreshFn --> JobsTable
