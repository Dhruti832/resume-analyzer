resource "aws_s3_bucket" "frontend" {
  bucket = "resume-analyzer-frontend-${data.aws_caller_identity.current.account_id}"
}

# Bucket stays fully private — the browser never talks to S3 directly.
# The serveFrontend Lambda (lambda_serve_frontend.tf) reads objects via
# LabRole and serves them over HTTPS through API Gateway.
resource "aws_s3_bucket_public_access_block" "frontend" {
  bucket = aws_s3_bucket.frontend.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# config.js is generated by Terraform so all frontend pages get live values
# (API URL, Cognito client ID, hosted-UI base, frontend HTTPS URL) without
# any hardcoding in the HTML files themselves.
resource "aws_s3_object" "frontend_config" {
  bucket       = aws_s3_bucket.frontend.bucket
  key          = "config.js"
  content_type = "application/javascript"
  content      = <<-JS
    window.APP_CONFIG = {
      apiBase:         "${aws_apigatewayv2_api.main.api_endpoint}",
      cognitoClientId: "${aws_cognito_user_pool_client.frontend.id}",
      cognitoLoginUrl: "https://${aws_cognito_user_pool_domain.main.domain}.auth.us-east-1.amazoncognito.com",
      frontendBase:    "${aws_apigatewayv2_api.frontend.api_endpoint}"
    };
  JS
}

resource "aws_s3_object" "frontend_index" {
  bucket       = aws_s3_bucket.frontend.bucket
  key          = "index.html"
  source       = "${path.module}/../frontend/index.html"
  content_type = "text/html"
  etag         = filemd5("${path.module}/../frontend/index.html")
}

